        <mxCell id="mkKk8QYguHdA_0xZ13gF-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="- SEG1(idTemp1, inicio1) := π idTemporada→idTemp1, inicio→inicio1 ( σ denominacionOficial = &#39;Segunda Division&#39; (Temporada) )&#xa;- SEG2(idTemp2, inicio2) :=π idTemporada→idTemp2, inicio→inicio2( σ denominacionOficial = &#39;Segunda Division&#39; (Temporada) )&#xa;- ULTIMAS5(idTemp1, inicio1) :=π idTemp1, inicio1( σ numMayores &amp;lt; 5( AGRUPAR contar(idTemp2)→numMayores( σ inicio2 &amp;gt; inicio1 (SEG1 × SEG2), idTemp1, inicio1 )))&#xa;- GOLES_JORN(idTemp1, inicio1, denominacionNumerica, golesJornada) := AGRUPAR suma(golesLocal + golesVisitante)→golesJornada ( (ULTIMAS5 ⋈ (idTemp1 = idTemporada) Jornada) ⋈ (Jornada.idJornada = Partido.idJornada) Partido, idTemp1, inicio1, denominacionNumerica)&#xa;- RESULTADO(inicio1, denominacionNumerica, golesJornada) :=π inicio1, denominacionNumerica, golesJornada ( σ golesJornada = maxGoles( GOLES_JORN ⋈ AGRUPAR max(golesJornada)→maxGoles&#xa;( GOLES_JORN, idTemp1 )))" vertex="1">
